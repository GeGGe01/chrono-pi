---
import type { CollisionSearchesArtifact, CollisionsArtifact } from 'chrono-pi-data';

interface Props {
  collisions: CollisionsArtifact;
  searches: CollisionSearchesArtifact;
}

const { collisions, searches } = Astro.props;

const STATUS_LABEL = {
  verified: 'Verified',
  'model-dependent': 'Model-dependent',
} as const;

const KIND_LABEL = {
  double: 'Double π',
  triple: 'Triple π',
} as const;

function calendarLabel(search: CollisionSearchesArtifact['searches'][number], id: string): string {
  return search.calendars.find((calendar) => calendar.id === id)?.label ?? id;
}

function formatYears(years: number): string {
  if (years >= 1e9) return `${(years / 1e9).toFixed(2)} billion years`;
  if (years >= 1e6) return `${(years / 1e6).toFixed(2)} million years`;
  return `${Math.round(years).toLocaleString('en-US')} years`;
}

function formatDays(days: number): string {
  return days.toLocaleString('en-US');
}

// A confirmed-at instant, shown in UTC so the stamp is timezone-free (the reckoning credits the
// commit, not a person's local clock). Returns e.g. "2026-08-28 09:26 UTC".
function formatFoundAt(iso: string): string {
  const d = new Date(iso);
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())} UTC`;
}
---

<section class="fame">
  <h2>Collision search</h2>
  <p class="sub">
    Known witnesses, now with the CRT mechanics that determine how many collision classes survive.
  </p>
  <div class="cards">
    {
      searches.searches.map((search) => (
        <article class:list={['card', { triple: search.kind === 'triple' }]}>
          <div class="eyebrow">
            <span>{KIND_LABEL[search.kind]}</span>
            <span class="status">{STATUS_LABEL[search.status]}</span>
          </div>
          <h3>{search.label}</h3>
          <p class="cdate">{search.isoDate}</p>
          {search.foundAt && (
            <p class="confirmed">
              <span class="dot" /> Confirmed {formatFoundAt(search.foundAt)}
            </p>
          )}
          <p class="cals">{search.calendars.map((calendar) => calendar.label).join(' ∩ ')}</p>

          <ul class="reads">
            {search.calendars.map((calendar) => (
              <li>
                <span class="cal">{calendar.label}</span>
                <span class="digits">{calendar.read}</span>
              </li>
            ))}
          </ul>

          {search.mechanics && (
            <div class="mechanics">
              <div>
                <span class="metric-label">Witnesses / cycle</span>
                <strong>N = {search.mechanics.witnessCount}</strong>
              </div>
              <div>
                <span class="metric-label">Mean interval</span>
                <strong>{formatYears(search.mechanics.meanIntervalYears)}</strong>
              </div>
              <div class="wide">
                <span class="metric-label">Supercycle</span>
                <strong>{formatDays(search.mechanics.supercycleDays)} days</strong>
              </div>
              <div class="wide">
                <span class="metric-label">gcd filters</span>
                <span class="gcds">
                  {search.mechanics.gcdConstraints
                    .map(
                      ({ left, right, gcd }) =>
                        `${calendarLabel(search, left)} / ${calendarLabel(search, right)} = ${gcd}`,
                    )
                    .join(' · ')}
                </span>
              </div>
            </div>
          )}

          {search.model && <p class="model">Model: {search.model}</p>}
          {search.note && <p class="note">{search.note}</p>}
        </article>
      ))
    }
  </div>
  {
    collisions.windowCollisions.length === 0 && (
      <p class="none">
        None yet inside the 2000–2226 window — the clean collisions are ancient or deep-future.
      </p>
    )
  }
</section>

<style>
  .sub {
    color: var(--muted);
    margin-top: 0.25rem;
    max-width: 44rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.25rem;
    min-width: 0;
  }
  .card.triple {
    border-color: color-mix(in srgb, var(--accent-2) 45%, var(--line));
  }
  .eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.68rem;
    color: var(--accent-2);
  }
  .status {
    color: var(--muted);
    text-align: right;
  }
  h3 {
    font-size: 1rem;
    margin-top: 0.5rem;
  }
  .cdate {
    font-family: var(--mono);
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    font-weight: 700;
    margin-top: 0.2rem;
    overflow-wrap: anywhere;
  }
  .cals {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .confirmed {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent-2);
  }
  .confirmed .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent-2);
    flex: none;
  }
  .reads {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .reads li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.4rem;
    font-size: 0.85rem;
  }
  .reads .digits {
    text-align: right;
    overflow-wrap: anywhere;
  }
  .cal {
    font-weight: 600;
  }
  .mechanics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .mechanics > div {
    min-width: 0;
  }
  .mechanics .wide {
    grid-column: 1 / -1;
  }
  .metric-label {
    display: block;
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .mechanics strong,
  .gcds {
    display: block;
    margin-top: 0.1rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
  .model,
  .note {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .note {
    font-style: italic;
  }
  .none {
    margin-top: 1.5rem;
    color: var(--muted);
    font-style: italic;
  }
  @media (max-width: 32rem) {
    .mechanics {
      grid-template-columns: 1fr;
    }
    .mechanics .wide {
      grid-column: auto;
    }
  }
</style>
