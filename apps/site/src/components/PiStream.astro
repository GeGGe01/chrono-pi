---
import { PI_DIGITS } from 'chrono-pi-engine';

import { streamHighlight } from '../lib/view';

interface Props {
  depth: number;
}

const { depth } = Astro.props;
const lit = streamHighlight(depth);
const matched = PI_DIGITS.slice(1, lit); // fractional digits the next day reaches
const rest = PI_DIGITS.slice(lit);
---

<section class="stream" aria-label={`π to ${PI_DIGITS.length} digits, the next day matching ${depth}`}>
  <div class="band" aria-hidden="true">
    <span class="pi">3.</span><span class="lit">{matched}</span><span class="rest">{rest}</span>
  </div>
</section>

<style>
  .stream {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .band {
    font-family: var(--mono);
    font-size: clamp(1.1rem, 3.5vw, 1.6rem);
    white-space: nowrap;
    letter-spacing: 0.08em;
    will-change: transform;
    animation: drift 90s linear infinite;
  }
  .pi {
    color: var(--fg);
  }
  .lit {
    color: var(--accent);
    text-shadow: 0 0 12px rgba(255, 210, 63, 0.45);
  }
  .rest {
    color: var(--muted);
  }
  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-30%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .band {
      animation: none;
      white-space: normal;
      word-break: break-all;
    }
    .stream {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
