---
interface Props {
  // Calendars in display order. `found: false` means the engine has no perfect day for it yet
  // (e.g. Persian isn't implemented) — it shows greyed as "until further notice", not toggleable.
  calendars: { id: string; found: boolean }[];
}

const { calendars } = Astro.props;

// Pre-selected on first visit; the cookie overrides thereafter.
const DEFAULTS = ['gregorian', 'julian', 'islamic', 'persian'];
// The anchor calendar — the reference all dates are read against. Locked on (pre-checked, not
// unclickable) for now; a future feature lets the visitor re-anchor.
const ANCHOR = 'gregorian';

const LABELS: Record<string, string> = { islamic: 'Hijri', 'julian-period': 'Julian Period' };
const label = (id: string) => LABELS[id] ?? id.charAt(0).toUpperCase() + id.slice(1);
---

<details class="calfilter" open>
  <summary>Calendars shown</summary>
  <p class="hint">
    Pick which calendars appear below. <strong>Gregorian</strong> is the anchor — always shown.
  </p>
  <div class="opts">
    {
      calendars.map(({ id, found }) => (
        <label class:list={['opt', { pending: !found }]}>
          <input
            type="checkbox"
            data-cal-toggle
            value={id}
            checked={found && (id === ANCHOR || DEFAULTS.includes(id))}
            disabled={id === ANCHOR || !found}
          />
          <span>
            {label(id)}
            {id === ANCHOR && found && <span class="anchor-tag">anchor</span>}
            {!found && <span class="pending-tag">until further notice</span>}
          </span>
        </label>
      ))
    }
  </div>
</details>

<script>
  // Client island: persist the visible-calendar set in an "eternity" cookie and toggle every
  // [data-calendar] element accordingly. No server round-trip — the site stays static.
  const COOKIE = 'chrono_cals';
  const DEFAULTS = ['gregorian', 'julian', 'islamic', 'persian'];
  const ANCHOR = 'gregorian'; // always shown — the reference calendar, cannot be toggled off
  const TEN_YEARS = 60 * 60 * 24 * 365 * 10;

  function readCookie(): string[] | null {
    const m = document.cookie.match(/(?:^|;\s*)chrono_cals=([^;]*)/);
    if (!m) return null;
    const v = decodeURIComponent(m[1]).trim();
    return v === '' ? [] : v.split(',');
  }

  function writeCookie(ids: string[]): void {
    document.cookie = `${COOKIE}=${encodeURIComponent(ids.join(','))}; path=/; max-age=${TEN_YEARS}; SameSite=Lax`;
  }

  function apply(ids: string[]): void {
    const set = new Set(ids);
    document.querySelectorAll<HTMLElement>('[data-calendar]').forEach((el) => {
      el.hidden = !set.has(el.dataset.calendar ?? '');
    });
  }

  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-cal-toggle]'));
  // The anchor is always in the set, whatever the cookie says.
  const stored = Array.from(new Set([ANCHOR, ...(readCookie() ?? DEFAULTS)]));
  const storedSet = new Set(stored);
  inputs.forEach((i) => {
    i.checked = i.value === ANCHOR || storedSet.has(i.value);
  });
  apply(stored);

  inputs.forEach((i) =>
    i.addEventListener('change', () => {
      const ids = Array.from(
        new Set([ANCHOR, ...inputs.filter((x) => x.checked).map((x) => x.value)]),
      );
      writeCookie(ids);
      apply(ids);
    }),
  );
</script>

<style>
  .calfilter {
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  .hint {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0.5rem 0 0.75rem;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
  }
  input {
    accent-color: var(--accent);
  }
  .anchor-tag {
    margin-left: 0.35rem;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    padding: 0 0.3rem;
  }
  /* Calendars the engine hasn't found a perfect day for yet: greyed and locked off. */
  .opt.pending {
    color: var(--muted);
    opacity: 0.55;
    cursor: not-allowed;
  }
  .opt.pending input {
    cursor: not-allowed;
  }
  .pending-tag {
    margin-left: 0.35rem;
    font-size: 0.62rem;
    font-style: italic;
    color: var(--muted);
  }
</style>
