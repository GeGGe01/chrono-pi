---
import { getCollisionSearches, getCollisions, getPerfectDays } from 'chrono-pi-data';

import CalendarFilter from '../components/CalendarFilter.astro';
import Countdown from '../components/Countdown.astro';
import HallOfFame from '../components/HallOfFame.astro';
import LatestWriting from '../components/LatestWriting.astro';
import PiStream from '../components/PiStream.astro';
import Timeline from '../components/Timeline.astro';
import UpcomingQueue from '../components/UpcomingQueue.astro';
import Layout from '../layouts/Layout.astro';
import { nextPerfectDay, upcomingDays } from '../lib/view';

const { window: lifeWindow, days } = getPerfectDays();
const collisions = getCollisions();
const collisionSearches = getCollisionSearches();

// Build-time "now" in UTC; the countdown island recomputes live in the visitor's local time.
const now = new Date().toISOString().slice(0, 10);
const next = nextPerfectDay(days, now);
const upcoming = upcomingDays(days, now, 12);

// The calendars the filter shows. Two classes:
//  - found:    the engine has ≥1 perfect day for it — toggleable.
//  - pending:  a headline calendar we intend to support but haven't found a day for yet
//              (e.g. Persian isn't implemented) — shown greyed as "until further notice".
// The four defaults are always listed (as pending if not yet found) so the intent is visible.
const CAL_ORDER = ['gregorian', 'julian', 'islamic', 'persian'];
const DEFAULT_CALENDARS = ['gregorian', 'julian', 'islamic', 'persian'];
const calendarChoices = (() => {
  const found = new Set<string>();
  for (const d of days) found.add(d.calendarId);
  for (const w of collisions.witnesses) for (const r of w.perfectDays) found.add(r.calendarId);
  const shown = new Set<string>([...found, ...DEFAULT_CALENDARS]);
  const rank = (id: string) => (CAL_ORDER.indexOf(id) === -1 ? CAL_ORDER.length : CAL_ORDER.indexOf(id));
  return [...shown]
    .sort((a, b) => rank(a) - rank(b) || a.localeCompare(b))
    .map((id) => ({ id, found: found.has(id) }));
})();
---

<Layout title="chrono-pi — the next perfect pi-day">
  {
    next ? (
      <Fragment>
        <Countdown day={next} />
        <PiStream depth={next.depth} />
      </Fragment>
    ) : (
      <p>No more perfect pi-days inside the lifetime window.</p>
    )
  }
  <CalendarFilter calendars={calendarChoices} />
  <UpcomingQueue days={upcoming} />
  <Timeline days={days} windowStart={lifeWindow.start} windowEnd={lifeWindow.end} nowIso={now} />
  <HallOfFame collisions={collisions} searches={collisionSearches} />
  <LatestWriting />
</Layout>
